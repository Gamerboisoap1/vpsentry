#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$PROJECT_DIR/data/vpsentry.pid"
pid=''
if [[ -f "$PID_FILE" ]]; then
  pid="$(cat "$PID_FILE")"
fi

if [[ -n "$pid" ]]; then
  sudo kill -TERM -- "-$pid" 2>/dev/null || true
  for _ in {1..15}; do
    if ! sudo kill -0 -- "-$pid" 2>/dev/null; then
      break
    fi
    sleep 1
  done
  sudo kill -KILL -- "-$pid" 2>/dev/null || true
fi

# Clean up a detached/stale VPSentry listener if its PID file was lost.
if command -v fuser >/dev/null 2>&1; then
  sudo fuser -k 8787/tcp 2>/dev/null || true
fi
rm -f "$PID_FILE"
printf 'VPSentry and its monitor processes are stopped.\n'
