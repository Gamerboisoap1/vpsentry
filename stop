#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$PROJECT_DIR/data/vpsentry.pid"
if [[ ! -f "$PID_FILE" ]]; then
  printf 'VPSentry is not running.\n'
  exit 0
fi
pid="$(cat "$PID_FILE")"
sudo kill -- "-$pid" 2>/dev/null || sudo kill "$pid" 2>/dev/null || true
rm -f "$PID_FILE"
printf 'VPSentry stopped.\n'

