VPSENTRY_HOST=0.0.0.0
VPSENTRY_PORT=8787
VPSENTRY_DATA_DIR=/var/lib/vpsentry
VPSENTRY_FRONTEND_DIR=/opt/vpsentry/current/frontend/dist
VPSENTRY_SSH_SOURCE=journal
VPSENTRY_AUTH_LOG=/var/log/auth.log
VPSENTRY_SSH_THRESHOLD=2
VPSENTRY_SSH_WINDOW=60
VPSENTRY_SCAN_THRESHOLD=1
VPSENTRY_SCAN_WINDOW=60
VPSENTRY_SAMPLE_SECONDS=5
VPSENTRY_RETENTION_DAYS=30
VPSENTRY_SUSPICIOUS_PORTS=23,3389,6379,27017
VPSENTRY_WATCH_FILES=/etc/ssh/sshd_config,/etc/passwd,/etc/sudoers
VPSENTRY_DEFENSE_SECONDS=10
VPSENTRY_PROCESS_CPU_THRESHOLD=85
VPSENTRY_PROCESS_MEMORY_THRESHOLD=50

# Sends public attack-source IPs to ipwho.is over HTTPS; set false to keep all data local.
VPSENTRY_GEOIP_ENABLED=true
VPSENTRY_GEOIP_DAILY_LIMIT=500
