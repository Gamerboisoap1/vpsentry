#!/usr/bin/env bash
set -Eeuo pipefail

PROJECT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PID_FILE="$PROJECT_DIR/data/vpsentry.pid"
LOG_FILE="$PROJECT_DIR/data/vpsentry.log"
mkdir -p "$PROJECT_DIR/data"

if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  printf 'VPSentry is already running (PID %s).\n' "$(cat "$PID_FILE")"
  exit 0
fi

setsid sudo "$PROJECT_DIR/RUN" >>"$LOG_FILE" 2>&1 &
echo $! >"$PID_FILE"
sleep 1
printf 'VPSentry started in the background.\nLog: %s\n' "$LOG_FILE"

